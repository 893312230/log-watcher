# 生产环境密钥模板：复制为 .env 并填入真实值（.env 不进 git）
# Kimi（Moonshot）开放平台 API Key，platform.moonshot.cn 申请
# 纯文本/代码补全场景使用（supportsTools=false）
MOONSHOT_API_KEY=
# DeepSeek API Key，platform.deepseek.com 申请
# 工具调用场景使用（supportsTools=true，ReAct/MCP 工具路由到此端点）
DEEPSEEK_API_KEY=
# MySQL root 密码（建议随机强密码）
MYSQL_PASSWORD=
# Redis 访问密码（建议随机强密码）
REDIS_PASSWORD=
# JWT 签名密钥（≥32 字节随机串，例：openssl rand -hex 32）
SMARTOPS_JWT_SECRET=
# admin 初始密码（仅首次启动 sys_user 为空时写入，登录后请尽快修改）
SMARTOPS_ADMIN_PASSWORD=
