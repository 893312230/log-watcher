<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 基础设施模块：记忆系统、RAG、MCP、A2A、安全、并发、配置
         依赖 common + domain，对外暴露接口，实现在 impl 子包。 -->
    <parent>
        <groupId>com.smartops</groupId>
        <artifactId>smart-ops-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>smart-ops-infrastructure</artifactId>
    <name>smart-ops-infrastructure</name>
    <description>基础设施模块 - 记忆/RAG/MCP/A2A/安全/并发</description>

    <dependencies>
        <dependency>
            <groupId>com.smartops</groupId>
            <artifactId>smart-ops-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.smartops</groupId>
            <artifactId>smart-ops-domain</artifactId>
        </dependency>
        <!-- 阶段十五：ML 日志定级（Tribuo 逻辑回归，进程内训练与推理，版本根 pom 统一管理） -->
        <dependency>
            <groupId>org.tribuo</groupId>
            <artifactId>tribuo-classification-sgd</artifactId>
        </dependency>

        <!-- Spring AI 核心：ChatClient、ChatMemory 抽象
             BOM 管理版本，无需显式声明 version -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!-- Spring AI OpenAI 模型实现：阶段四 Embedding（Ollama OpenAI 兼容端点，ADR-015） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <!-- Spring AI ES 向量库：阶段四两级混合检索（BM25 + 向量 + RRF，ADR-016） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-elasticsearch-store</artifactId>
        </dependency>
        <!-- MCP Client：连接 Prometheus、MySQL 等外部 MCP Server -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- Spring Data Redis：长期记忆存储 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Spring Data JPA：业务数据持久化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Spring Security Core：审计 actor 解析当前登录用户（仅 core，无 web 自动配置） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Boot 4 测试切片已模块化：@DataJpaTest 独立为 data-jpa-test 启动器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2：@DataJpaTest 切片测试的嵌入式数据库（版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reactor 测试工具：StepVerifier 验证 SSE 告警流（版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Resilience4j 熔断器（阶段五韧性增强，spring-boot4 专用于 Spring Boot 4.x） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.92</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.86</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
